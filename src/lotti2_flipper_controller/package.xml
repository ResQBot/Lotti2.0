<?xml version="1.0"?>
<package format="3">
    <name>lotti2_flipper_controller</name>
    <version>0.0.1</version>
    <description>Controller for the Lotti2-Robot's flippers</description>
    <maintainer email="office@campus-robo.at">Paul Kupka</maintainer>
    <license>Apache License 2.0</license>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <build_depend>ros2_control_cmake</build_depend>

    <depend>angles</depend>
    <depend>backward_ros</depend>
    <depend>controller_interface</depend>
    <depend>control_msgs</depend>
    <depend>control_toolbox</depend>
    <depend>generate_parameter_library</depend>
    <depend>hardware_interface</depend>
    <depend>libexpected-dev</depend>
    <depend>pluginlib</depend>
    <depend>rclcpp</depend>
    <depend>rclcpp_action</depend>
    <depend>rclcpp_lifecycle</depend>
    <depend>realtime_tools</depend>
    <depend>rsl</depend>
    <!-- <depend>lotti2_msgs</depend> -->
    <depend>std_msgs</depend>


    <test_depend>ament_cmake_gmock</test_depend>
    <test_depend>controller_manager</test_depend>
    <test_depend>hardware_interface_testing</test_depend>
    <test_depend>ros2_control_test_assets</test_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
