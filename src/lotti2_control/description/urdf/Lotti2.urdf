  <!-- <xacro:include filename="Lotti_lidar.xacro"/> -->
  <ros2_control name="Lotti2Flipper" rw_rate="50" type="system">
    <hardware>
      <plugin>lotti2_flipper_interface/FlipperInterface</plugin>
      <param name="device">/dev/serial/by-id/usb-FTDI_USB__-__Serial_Converter_FTA2HIEQ-if00-port0</param>
      <!--  <param name="max_torque">0.006</param> -->
      <!-- <param name="gear_ratio">1.0</param> -->
      <param name="use_hardware">0</param>
    </hardware>
    <joint name="flipper_fr_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="temp"/>
    </joint>
    <joint name="flipper_fl_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="temp"/>
    </joint>
    <joint name="flipper_rr_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="temp"/>
    </joint>
    <joint name="flipper_rl_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="temp"/>
    </joint>
  </ros2_control>
  <ros2_control name="Lotti2Chains" type="system">
    <hardware>
      <plugin>lotti2_drive_interface/DriveInterface</plugin>
      <param name="device">/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0</param>
      <param name="e_conversion">21</param>
      <!-- motorRPM to eRPM equal to number of polepairs-->
      <param name="gear_ratio">9</param>
      <!-- gearbox ratio -->
      <param name="Kt">0.198</param>
      <!-- Kt value for the motor [Nm/A] -->
      <param name="use_hardware">0</param>
    </hardware>
    <joint name="left_chain_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="temp"/>
    </joint>
    <joint name="right_chain_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="temp"/>
    </joint>
  </ros2_control>
  <ros2_control name="Lotti2Arm" rw_rate="50" type="system">
    <hardware>
      <plugin>lotti2_arm_interface/ArmInterface</plugin>
      <param name="device"/>
      <!-- name of serial device used to sommunicate with the motors -->
      <param name="use_synchronization">0</param>
      <!-- motors can be forced to execute commands synchronously -->
      <param name="gear_ratio">25.0</param>
      <!-- gear ration of cycloidal gears in arm assembly -->
      <param name="resolution">16384</param>
      <!-- steps per one full motor rotation-->
      <param name="acceleration">100</param>
      <!-- motor acceleration | max 255-->
      <param name="use_hardware">0</param>
      <!-- set to 1 of physical hardware is used. Set to 0 if only digital representation is used -->
    </hardware>
    <joint name="arm1_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="arm2_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="arm3_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="arm4_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="arm5_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="arm6_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
